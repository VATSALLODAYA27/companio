# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ── Database (PostgreSQL + PostGIS) ─────────────────────────────────
# Never commit real credentials. This is a local-dev placeholder.
DATABASE_URL="postgresql://companio:companio_dev_password@localhost:5432/companio?schema=public"

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Session / cookies ────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-value"
SESSION_COOKIE_NAME="companio_sid"
SESSION_TTL_HOURS=24

# ── CSRF ─────────────────────────────────────────────────────────────
CSRF_SECRET="replace-with-a-long-random-value"

# ── Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGIN="http://localhost:3000"

# ── Rate limiting ────────────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_DEFAULT=100
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_DISCOVERY=20

# ── Discovery / location ─────────────────────────────────────────────
DEFAULT_SEARCH_RADIUS_METERS=1000
