# Companio — production/self-hosted deployment env (Phase 11)
#
# Consumed by `docker-compose.prod.yml`. Copy this to `.env.prod` (not
# `.env` — that name is reserved for docker-compose.yml's local dev
# stack, and Compose would otherwise auto-load it for both) and fill in
# real values — never commit that file (see .gitignore). Then run Compose
# with an explicit --env-file, e.g.:
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml \
#     --profile migrate up migrate
#   docker compose --env-file .env.prod -f docker-compose.prod.yml \
#     up -d db redis api web
#
# Every value below with no safe default is required; docker-compose.prod.yml
# fails fast with a clear error if one is missing, rather than silently
# starting with a guessable default.
#
# This is a superset of, and deliberately separate from, .env.example
# (which is for running `apps/api`/`apps/web` directly against the local
# dev stack in docker-compose.yml — no Postgres role vars there because
# that file hardcodes a dev-only password). See DEPLOYMENT.md for the
# full walkthrough.

# ── Docker image tag ────────────────────────────────────────────────
# Tag applied to images built by `docker compose -f docker-compose.prod.yml
# build`. Bump this (e.g. to a git SHA or version) as part of your release
# process if you want old images kept around for rollback; "latest" is
# fine for a single-host deploy with no rollback story yet.
IMAGE_TAG=latest

# ── Postgres role (consumed by the `db` container itself) ──────────
# Generate a real password with: openssl rand -base64 32
POSTGRES_USER=companio
POSTGRES_PASSWORD="replace-with-a-long-random-value"
POSTGRES_DB=companio

# ── App ──────────────────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=3000

# ── Database (PostgreSQL + PostGIS) ─────────────────────────────────
# Host is the compose service name `db`, not localhost — containers reach
# each other by service name on the compose network. Must match
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
DATABASE_URL="postgresql://companio:replace-with-a-long-random-value@db:5432/companio?schema=public"
# Optional — see SCALING.md "Connection pool" before setting this for a
# real deployment; unset = pg's own default (10).
# DB_POOL_MAX=25

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ── Session / cookies ────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-value"
SESSION_COOKIE_NAME="companio_sid"
SESSION_TTL_HOURS=24

# ── CSRF ─────────────────────────────────────────────────────────────
CSRF_SECRET="replace-with-a-long-random-value"

# ── Google OAuth ─────────────────────────────────────────────────────
# Callback URL must be registered in the Google Cloud Console for this
# OAuth client and must point at your real public domain, not localhost.
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="https://api.your-real-domain.example/api/v1/auth/google/callback"

# ── CORS ─────────────────────────────────────────────────────────────
# The exact origin the web app is served from. Credentialed (cookie)
# requests require an exact match — never a wildcard.
CORS_ALLOWED_ORIGIN="https://your-real-domain.example"

# ── Rate limiting ────────────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_DEFAULT=100
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_DISCOVERY=20
RATE_LIMIT_MAX_CONNECTIONS=20
RATE_LIMIT_MAX_MESSAGES=60
RATE_LIMIT_MAX_MAP=20
RATE_LIMIT_MAX_REPORTS=5

# ── Discovery / location ─────────────────────────────────────────────
DEFAULT_SEARCH_RADIUS_METERS=1000
