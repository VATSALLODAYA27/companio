// Companio — Prisma schema (Phase 1)
//
// Notes:
// - UUID primary keys everywhere (no sequential public IDs).
// - `UserLocation.geo` is a PostGIS geography(Point,4326) column. Prisma has
//   no native geography type, so it is declared `Unsupported(...)` — Prisma
//   will create the column but all spatial querying happens via raw SQL in
//   apps/api/src/discovery/discovery.repository.ts. Do not add application
//   logic that reads/writes this column through the generated client.
// - No location history table by design — UserLocation is upserted in place.
// - Verification stores only provider/status/timestamp — never raw KYC data.
//
// Engine (Phase 3.5): `engineType = "wasm"` — the generated client runs
// entirely on the bundled WASM query engine plus a driver adapter
// (@prisma/adapter-pg), never a native engine binary. See ARCHITECTURE.md
// "Prisma engine strategy" for why. The connection string lives in
// PrismaService (constructed from DATABASE_URL via ConfigService), not in
// this datasource block — Prisma 7 no longer reads `url` from the schema
// for the generated client (prisma.config.ts supplies it to the CLI only,
// for `generate`/`migrate`/`studio`).

generator client {
  provider        = "prisma-client-js"
  engineType      = "wasm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// ─────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Availability {
  NOW
  TODAY
  WEEKEND
  NOT_AVAILABLE
}

enum VerificationProvider {
  GOOGLE
  GOVERNMENT_KYC
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ReportCategory {
  HARASSMENT
  SPAM
  FAKE_PROFILE
  INAPPROPRIATE_BEHAVIOR
  SUSPICIOUS_ACTIVITY
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

// ─────────────────────────────────────────────────────────────────────
// Core identity
// ─────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  googleId     String?    @unique
  passwordHash String? // null for OAuth-only accounts; argon2id when set
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  profile       Profile?
  location      UserLocation?
  activities    UserActivity[]
  verifications Verification[]
  sessions      Session[]

  sentRequests     ConnectionRequest[] @relation("Requester")
  receivedRequests ConnectionRequest[] @relation("Recipient")

  connectionsAsA Connection[] @relation("UserA")
  connectionsAsB Connection[] @relation("UserB")

  messagesSent Message[]

  reportsFiled    Report[] @relation("Reporter")
  reportsReceived Report[] @relation("Reported")

  blocksInitiated Block[] @relation("Blocker")
  blocksReceived  Block[] @relation("Blocked")

  @@index([status])
  @@map("users")
}

// First-party server-side session record. The session cookie holds only
// this row's id — never a JWT with embedded claims — so revocation is a
// single DELETE, not a token blocklist.
model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgentHash String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  photoUrl     String?
  ageRange     String? // bucketed e.g. "18-24" — not a stored date of birth
  bio          String?  @db.VarChar(280)
  city         String?
  languages    String[]
  discoverable Boolean  @default(true) // opt-in to appearing in discovery
  hidden       Boolean  @default(false) // manual "hide me now" toggle
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────────────
// Activities
// ─────────────────────────────────────────────────────────────────────

model Activity {
  id    String @id @default(uuid())
  key   String @unique // "trekking", "bowling", ...
  label String

  userActivities UserActivity[]

  @@map("activities")
}

model UserActivity {
  id           String       @id @default(uuid())
  userId       String
  activityId   String
  availability Availability @default(NOT_AVAILABLE)
  updatedAt    DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([activityId, availability]) // core of the nearby-match query
  @@map("user_activities")
}

// ─────────────────────────────────────────────────────────────────────
// Location — current position only, no history
// ─────────────────────────────────────────────────────────────────────

model UserLocation {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  geo       Unsupported("geography(Point, 4326)")?
  geohash6  String? // coarse ~1.2km cell — safe to log/cache, never the exact point
  updatedAt DateTime @updatedAt

  @@map("user_locations")
}

// ─────────────────────────────────────────────────────────────────────
// Verification — minimum result only, never raw identity documents
// ─────────────────────────────────────────────────────────────────────

model Verification {
  id         String               @id @default(uuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   VerificationProvider
  status     VerificationStatus
  verifiedAt DateTime?
  createdAt  DateTime             @default(now())

  @@index([userId, status])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────────────
// Connections
// ─────────────────────────────────────────────────────────────────────

model ConnectionRequest {
  id          String        @id @default(uuid())
  requesterId String
  recipientId String
  activityId  String
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  respondedAt DateTime?

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([requesterId, status])
  @@map("connection_requests")
}

model Connection {
  id         String    @id @default(uuid())
  userAId    String
  userBId    String
  activityId String
  createdAt  DateTime  @default(now())
  removedAt  DateTime?

  userA        User          @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User          @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([userAId, userBId, activityId])
  @@index([userAId])
  @@index([userBId])
  @@map("connections")
}

// ─────────────────────────────────────────────────────────────────────
// Chat
// ─────────────────────────────────────────────────────────────────────

model Conversation {
  id           String   @id @default(uuid())
  connectionId String   @unique
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String    @db.VarChar(2000)
  sentAt         DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────
// Safety
// ─────────────────────────────────────────────────────────────────────

model Report {
  id         String         @id @default(uuid())
  reporterId String
  reportedId String
  category   ReportCategory
  details    String?        @db.VarChar(1000)
  status     ReportStatus   @default(OPEN)
  createdAt  DateTime       @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId, status])
  @@map("reports")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}
